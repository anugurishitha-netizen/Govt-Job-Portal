# Frontend environment variables (optional on Vercel as it defaults to /api)
VITE_API_URL=/api

# Backend environment variables (Add these in Vercel Project Settings -> Environment Variables)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/govtjobportal?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_random_key_here
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
